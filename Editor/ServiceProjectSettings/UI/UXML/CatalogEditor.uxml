<UXML xmlns="UnityEngine.UIElements">
    <VisualElement name="CatalogEditorBlock">
        <VisualElement class="separator iap-section-separator" />
        <Label text="Legacy Catalog" class="iap-section-heading" />
        <Label text="This project still uses the local IAPProductCatalog.json. Convert it to a catalog CSV you can deploy to the Remote Catalog. Your existing file is left untouched and keeps working." class="iap-section-text" />
        <Button name="CatalogEditorButton" text="Migrate to Remote Catalog" class="iap-section-button" />
    </VisualElement>
</UXML>
