<UXML xmlns="UnityEngine.UIElements">
    <VisualElement name="XboxConfigBlock" class="project-settings-title-container">
        <VisualElement name="XboxConfigItem" class="configuration-item expanded">
            <VisualElement class="configuration-item-header">
                <Image name="XboxIcon" class="configuration-icon store-icon" />
                <VisualElement class="configuration-info">
                    <VisualElement class="configuration-name">
                        <Label text="Xbox" />
                    </VisualElement>
                    <Label text="Validate purchases with Microsoft Store." class="configuration-description" />
                </VisualElement>
                <VisualElement class="configuration-toggle" />
            </VisualElement>
            <VisualElement class="configuration-item-body">
                <HelpBox name="CloudCodeRequiredNote" text="Install the Cloud Code package to enable purchase validation." message-type="Info" class="configuration-help-box xbox-cloud-code-note" />
                <Toggle name="PurchaseValidationToggle" binding-path="m_EnablePurchaseValidation" label="Use Microsoft Store Services" class="xbox-field" />
                <TextField name="CloudCodeModuleNameField" label="Cloud Code Module Name" binding-path="m_CloudCodeModuleName" class="xbox-field"/>
                <TextField name="ServiceTicketFunctionNameField" label="Service Ticket Function Name" binding-path="m_ServiceTicketFunctionName" class="xbox-field"/>
                <TextField name="ValidatePurchaseFunctionNameField" label="Validate Purchase Function Name" binding-path="m_ValidatePurchaseFunctionName" class="xbox-field"/>
            </VisualElement>
        </VisualElement>
    </VisualElement>
</UXML>
