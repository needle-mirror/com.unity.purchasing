<UXML xmlns="UnityEngine.UIElements">
    <VisualElement name="AppleConfigBlock" class="project-settings-title-container">
        <VisualElement name="AppleConfigItem" class="configuration-item expanded">
            <VisualElement class="configuration-item-header">
                <Image name="AppleIcon" class="configuration-icon store-icon" />
                <VisualElement class="configuration-info">
                    <VisualElement class="configuration-name">
                        <Label text="Apple" />
                    </VisualElement>
                    <Label text="Apple App Store in-app payment." class="configuration-description" />
                </VisualElement>
                <VisualElement class="configuration-toggle" />
            </VisualElement>
            <VisualElement class="configuration-item-body">
                <Label text="Receipt obfuscation for Apple will create a Tangle class in your project, note that this does not replace server side validation." class="configuration-caption apple-note"/>
                <VisualElement class="configuration-buttons">
                    <Button name="ObfuscateKeysButton" text="Obfuscate License Keys" class="configuration-button"/>
                </VisualElement>
                <VisualElement name="verification">
                    <Label text="AppleTangle.cs has been generated and exists in your project." class="configuration-caption configuration-status"/>
                </VisualElement>
                <VisualElement name="error-message">
                    <Label text="-Apple Errors Show Here-." class="warning-message"/>
                </VisualElement>
            </VisualElement>
        </VisualElement>
    </VisualElement>
</UXML>
