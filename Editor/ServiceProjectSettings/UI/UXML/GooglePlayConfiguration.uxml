<UXML xmlns="UnityEngine.UIElements">
    <VisualElement name="UnlinkedSeparator" class="separator" />
    <VisualElement name="GoogleConfigBlock" class="project-settings-title-container">
        <VisualElement name="CodaConfigItem" class="configuration-item expanded">
            <VisualElement class="configuration-item-header">
                <Image class="configuration-icon coda" />
                <VisualElement class="configuration-info">
                    <VisualElement class="configuration-name">
                        <Label text="Coda" />
                        <VisualElement name="CodaConnectedBadge" class="configuration-badge connected">
                            <Label text="Connected" />
                        </VisualElement>
                        <VisualElement name="CodaNotConnectedBadge" class="configuration-badge">
                            <Label text="Not Connected" />
                        </VisualElement>
                    </VisualElement>
                    <Label text="A high-performant gaming payment solution with global reach, with frictionless checkout." class="configuration-description" />
                </VisualElement>
                <VisualElement class="configuration-toggle" />
            </VisualElement>
            <VisualElement class="configuration-item-body">
                <Label text="Connect Codapay to process D2C in-app purchases" class="configuration-body-title"/>
                <VisualElement class="configuration-list">
                    <VisualElement class="configuration-list-row">
                        <Label text="1. Connect Coda in your " class="configuration-list-item"/>
                        <Label name="CodaPaymentProviderLink" text="Unity Dashboard" class="configuration-list-item configuration-link"/>
                        <Label text="." class="configuration-list-item"/>
                    </VisualElement>
                    <VisualElement class="configuration-list-row">
                        <Label text="2. Coda's hosted pop-up will appear to install Unity's App. Follow the guided flow or refer to " class="configuration-list-item"/>
                        <Label name="CodaDocumentationLink" text="Documentation" class="configuration-list-item configuration-link"/>
                        <Label text="." class="configuration-list-item"/>
                    </VisualElement>
                    <Label text="3. Once the app install is successful, you'll be redirected back to your Unity Dashboard to finish setup." class="configuration-list-item"/>
                </VisualElement>
                <Label text="Note: In order to process live transactions, you will need to complete Coda's KYC verification, which is done in their dashboard." class="configuration-note"/>
            </VisualElement>
        </VisualElement>
        <VisualElement name="UnlinkedFeatures">
            <Label text="Link a cloud project to unlock these FREE features:" class="unlinked-features-heading" />
            <VisualElement class="configuration-item unlinked-feature">
                <Label text="Revenue reporting" class="unlinked-feature-title" />
                <Label text="See purchases and revenue across stores in the Unity Dashboard. Data only starts collecting once your project is linked." class="unlinked-feature-description" />
            </VisualElement>
            <VisualElement class="configuration-item unlinked-feature">
                <Label text="Remote catalog" class="unlinked-feature-title" />
                <Label text="Manage products and prices for every store in one catalog. Import your existing SKUs from the Editor, or upload a CSV." class="unlinked-feature-description" />
            </VisualElement>
            <VisualElement class="configuration-item unlinked-feature">
                <Label text="Webshops" class="unlinked-feature-title" />
                <Label text="Sell to players directly on the web, alongside the app stores." class="unlinked-feature-description" />
            </VisualElement>
            <VisualElement class="configuration-item unlinked-feature">
                <Label text="Payment Providers" class="unlinked-feature-title" />
                <Label text="Accept web payments through Stripe or Coda." class="unlinked-feature-description" />
            </VisualElement>
            <VisualElement class="separator" />
        </VisualElement>
        <VisualElement name="GooglePlayConfigItem" class="configuration-item expanded">
            <VisualElement class="configuration-item-header">
                <Image class="configuration-icon google-play" />
                <VisualElement class="configuration-info">
                    <VisualElement class="configuration-name">
                        <Label text="Google Play" />
                        <VisualElement name="GoogleKeyInfoIcon" class="configuration-info-icon" tooltip="How to find your Google license key&#10;&#10;1. Go to Google Play Console.&#10;2. Select your app.&#10;3. Go to Monetization setup to find your license key.">
                            <Label text="i" />
                        </VisualElement>
                        <VisualElement name="GoogleKeyConfiguredBadge" class="configuration-badge connected">
                            <Label text="Connected" />
                        </VisualElement>
                        <VisualElement name="GoogleKeyMissingBadge" class="configuration-badge missing-key">
                            <Label text="Missing license key" />
                        </VisualElement>
                    </VisualElement>
                    <Label text="Google Play Store in-app payment." class="configuration-description" />
                </VisualElement>
                <VisualElement class="configuration-toggle" />
            </VisualElement>
            <VisualElement class="configuration-item-body">
                <VisualElement name="RevenueValidationBlock">
                    <VisualElement name="missing-key-mode">
                        <HelpBox text="Your Google license key is missing. To remove this warning, add your license key to your cloud project settings, or enter the key in the Receipt Obfuscator field below and push to the cloud." message-type="Warning" class="configuration-help-box missing-key-box">
                            <Button name="GoToCloudProjectButton" text="Go to cloud project" />
                        </HelpBox>
                    </VisualElement>
                    <VisualElement name="error-unauthorized-user">
                        <HelpBox text="You are not authorized to view or set the license key of this cloud project." message-type="Error" class="configuration-help-box" />
                    </VisualElement>
                    <VisualElement name="error-server-error">
                        <HelpBox text="There was an error retrieving the key from the backend. Please try again later." message-type="Error" class="configuration-help-box" />
                    </VisualElement>
                    <VisualElement name="error-request-format">
                        <HelpBox text="The request to get the key on the dashboard was invalid. Please report this as a possible bug." message-type="Error" class="configuration-help-box" />
                    </VisualElement>
                </VisualElement>
                <VisualElement name="unlinked-missing-key-mode">
                    <HelpBox text="Your Google license key is missing. To remove this warning, connect to a cloud project and add your license key to your cloud project settings." message-type="Warning" class="configuration-help-box" />
                </VisualElement>
                <Toggle name="IgnoreGoogleLicenseKeyWarningToggle" text="Ignore Google license key warning in the editor logs." class="ignore-warning-toggle" />
                <VisualElement name="ReceiptObfuscatorBlock">
                    <Label name="ReceiptObfuscatorTitle" text="Receipt Obfuscator" class="configuration-body-title"/>
                    <Label text="Enter your license key in the input field below" class="configuration-caption"/>
                    <TextField name="GooglePlayKeyEntry" class="configuration-key-field" multiline="true"/>
                    <Label text="Receipt obfuscation for Google Play will create a Tangle class in your project, note that this does not replace server side validation." class="configuration-fine-print"/>
                    <VisualElement class="configuration-buttons">
                        <Button name="ObfuscateKeysButton" text="Obfuscate License Key" class="configuration-button"/>
                        <Button name="PushLicenseKeyButton" text="Push License Key to Cloud" class="configuration-button"/>
                    </VisualElement>
                    <VisualElement name="push-error">
                        <HelpBox message-type="Error" class="configuration-help-box configuration-inline-error" />
                    </VisualElement>
                    <VisualElement name="verification">
                        <Label text="GooglePlayTangle.cs has been generated and exists in your project." class="configuration-caption configuration-status"/>
                    </VisualElement>
                    <VisualElement name="error-message">
                        <Label text="-Google Errors Show Here-." class="warning-message"/>
                    </VisualElement>
                </VisualElement>
            </VisualElement>
        </VisualElement>
        <VisualElement name="StripeConfigItem" class="configuration-item expanded">
            <VisualElement class="configuration-item-header">
                <Image class="configuration-icon stripe" />
                <VisualElement class="configuration-info">
                    <VisualElement class="configuration-name">
                        <Label text="Stripe" />
                        <VisualElement name="StripeConnectedBadge" class="configuration-badge connected">
                            <Label text="Connected" />
                        </VisualElement>
                        <VisualElement name="StripeNotConnectedBadge" class="configuration-badge">
                            <Label text="Not Connected" />
                        </VisualElement>
                    </VisualElement>
                    <Label text="Accept in-app payments with a customizable checkout experience designed to boost conversion and reduce costs." class="configuration-description" />
                </VisualElement>
                <VisualElement class="configuration-toggle" />
            </VisualElement>
            <VisualElement class="configuration-item-body">
                <Label text="Connect Stripe to process D2C in-app purchases" class="configuration-body-title"/>
                <VisualElement class="configuration-list">
                    <VisualElement class="configuration-list-row">
                        <Label text="1. Connect Stripe in your " class="configuration-list-item"/>
                        <Label name="StripePaymentProviderLink" text="Unity Dashboard" class="configuration-list-item configuration-link"/>
                        <Label text="." class="configuration-list-item"/>
                    </VisualElement>
                    <VisualElement class="configuration-list-row">
                        <Label text="2. Stripe's hosted pop-up will appear to install Unity's App. Follow the guided flow or refer to " class="configuration-list-item"/>
                        <Label name="StripeDocumentationLink" text="Documentation" class="configuration-list-item configuration-link"/>
                        <Label text="." class="configuration-list-item"/>
                    </VisualElement>
                    <Label text="3. Once the app install is successful, you'll be redirected back to your Unity Dashboard to finish setup." class="configuration-list-item"/>
                </VisualElement>
                <Label text="Note: In order to process live transactions, you will need to complete Stripe's KYC verification, which is done in their dashboard." class="configuration-note"/>
            </VisualElement>
        </VisualElement>
    </VisualElement>
</UXML>
