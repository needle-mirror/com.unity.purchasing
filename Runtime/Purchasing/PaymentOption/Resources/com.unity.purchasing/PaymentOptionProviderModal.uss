/* BEM: block = unity-iap-picker, element = __X, modifier = --Y.
 * All selectors prefixed to prevent collisions with consumer USS.
 * Tokens scoped to .unity-iap-picker so consumers can re-theme by
 * overriding them in their own USS without forking this file:
 *
 *   .unity-iap-picker {
 *       --color-sheet: rgb(20,20,24);
 *       --color-sheet-border: rgb(60,60,70);
 *       --color-scrim: rgba(0,0,0,0.5);
 *   }
 *
 * The picker renders on its own panel, so that USS has to be added to the
 * picker's root, not the game's: see PaymentOptionProviderUITK.BuildPanel.
 *
 * Button colors, one background / text pair per kind of option (text colors
 * are always the ones that contrast their background):
 *   --color-generic-bg / --color-button-text         webshop, and a store
 *                                                    without a brand of its own
 *   --color-native-store-bg / --color-native-store-text
 *                                                    the native store (Apple's
 *                                                    In-App Purchase lockup, or
 *                                                    its name, e.g. the fake store)
 *   --color-google-play-bg / --color-google-play-text
 *                                                    Google Play
 *   --color-coda-bg / --color-coda-text              Coda
 *   --color-stripe-bg / --color-stripe-text          Stripe
 *   --color-mock-provider-bg / --color-mock-provider-text
 *                                                    the test PSP ("mock")
 * and the badge (the discount / bonus text on a button):
 *   --color-badge / --color-badge-text
 *
 * A button's logo follows its colors: the light variant when its text is lighter
 * than its background, the dark one otherwise (C#, PaymentOptionPopPalette.LogoTone).
 * Keep a dark-on-light or light-on-dark pair. Stripe ships a white logo only, so
 * keep --color-stripe-bg dark. Apple's brand guidelines allow the In-App Purchase
 * logo on black or white only: an override of --color-native-store-bg /
 * --color-native-store-text should stay a black and white pair.
 *
 * Units: the panel is scaled so that 1px here is 1pt (iOS point / Android dp).
 * Everything follows the Simple POP spec: sizes are PaymentOptionPopMetrics
 * and colors PaymentOptionPopPalette, and the two are kept in step by
 * PaymentOptionProviderUITKPanelTests / PaymentOptionProviderUITKCaptureTests. */

.unity-iap-picker {
    --color-scrim: rgba(0, 0, 0, 0.6);
    --color-sheet: rgb(255, 255, 255);
    --color-sheet-border: rgb(187, 187, 187);
    --color-title: rgb(32, 32, 32);
    --color-generic-bg: rgb(240, 240, 240);
    --color-button-text: rgb(0, 0, 0);
    --color-native-store-bg: rgb(0, 0, 0);
    --color-native-store-text: rgb(255, 255, 255);
    --color-google-play-bg: rgb(0, 0, 0);
    --color-google-play-text: rgb(255, 255, 255);
    --color-coda-bg: rgb(135, 135, 135);
    --color-coda-text: rgb(255, 255, 255);
    --color-stripe-bg: rgb(82, 58, 253);
    --color-stripe-text: rgb(255, 255, 255);
    --color-mock-provider-bg: rgb(135, 135, 135);
    --color-mock-provider-text: rgb(255, 255, 255);
    --color-close-glyph: rgb(131, 131, 131);
    --color-close-glyph-hover: rgb(80, 80, 90);
    --color-badge: rgb(196, 232, 209);
    --color-badge-text: rgb(25, 59, 45);

    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* The padding is the POP's screen margins: 16pt each side (PaymentOptionPopMetrics.SideMargin)
 * and, centered, 16pt above and below (CenteredVerticalMargin). The provider sets the
 * overlay's padding inline to these plus the safe area's insets (notch, home indicator),
 * so the margins are measured from the safe area's edges; the values here are the same
 * margins without insets, and overriding them from a stylesheet has no effect.
 * Centered: a row, so that the POP's width is its flex size: it starts from its
 * content, and flex-shrink narrows it to the space between the margins on a small
 * screen (down to its min-width) instead of letting it overflow. */
.unity-iap-picker__overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 16px;
    padding-bottom: 16px;
    background-color: var(--color-scrim);
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.unity-iap-picker__overlay--hidden {
    display: none;
}

/* Bottom-anchored (phone) layout; absence of this class is the centered
 * (tablet) layout. Toggled by ApplyBottomAnchoredLayout / ApplyCenteredLayout.
 * padding-bottom is PaymentOptionPopMetrics.BottomAnchoredMargin, with no top
 * margin: the scale arithmetic reserves exactly that much (both are set inline,
 * with the safe area's insets; see above). */
.unity-iap-picker__overlay--bottom {
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    padding-top: 0;
    padding-bottom: 48px;
}

/* The POP. Corner 12pt, border 1pt, and 20pt from its outer edge to the content
 * (PaymentOptionPopMetrics.Padding): the 1pt border plus 19pt of padding, the
 * same box UGUI draws and the one RequiredPopHeight reserves.
 *
 * Width rule, centered (tablet): its content's width, at least 375pt (the
 * __sheet-floor element below) and at most 500pt; narrowed to the space between
 * the side margins on a small screen, never below the spec's 340pt minimum. The
 * panel scale guarantees at least 340pt there, so the minimum only bites at the
 * scale floor. No percentage max-width: it makes UI Toolkit measure text as empty. */
.unity-iap-picker__sheet {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 340px;
    max-width: 500px;
    background-color: var(--color-sheet);
    border-width: 1px;
    border-color: var(--color-sheet-border);
    border-radius: 12px;
    padding: 19px;
}

/* Width rule, bottom-anchored (phone): fill between the side margins, 340..412pt.
 * A column here, with width: 100%: on 2022.3 a row item sized this way (by
 * width: 100% or flex-grow) ends up at its max-width instead of the space
 * between the margins once the panel narrows below it. */
.unity-iap-picker__overlay--bottom .unity-iap-picker__sheet {
    width: 100%;
    max-width: 412px;
}

/* 375pt (PaymentOptionPopMetrics.CenteredDefaultWidth) minus 2 x 20pt of border
 * and padding. Zero height, so it adds nothing to the POP's height; when the POP
 * is narrowed below 375pt it just overhangs the padding, invisibly. Centered, C#
 * widens it (inline) for a badged row whose content stays centered. */
.unity-iap-picker__sheet-floor {
    width: 335px;
    height: 0;
    flex-shrink: 0;
}

/* Sized to the 32pt cancel button rather than the 28pt text line (spec 18/28).
 * min-height, not height: a title that wraps at narrow widths grows the header
 * instead of spilling out of it. 20pt to the button box (HeaderGap). */
.unity-iap-picker__header {
    flex-direction: row;
    align-items: center;
    min-height: 32px;
    margin-bottom: 20px;
}

/* 18pt semibold in the spec; the built-in font has bold only.
 * min-width: 0 lets the title shrink (and wrap) instead of defaulting to its text width and running under the close button. */
.unity-iap-picker__title {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 28px;
    margin-right: 8px;
    font-size: 18px;
    color: var(--color-title);
    -unity-text-align: middle-left;
    -unity-font-style: bold;
    white-space: normal;
}

/* 44pt hit target (the platform minimum), laid out as the 32pt visible box: the
 * -6pt margins make it occupy 32pt in the header row and overhang by 6pt on
 * every side, so it is anchored right, in line with the header text, without
 * making the row taller. The cross itself is drawn by __close-glyph in this
 * element's color. */
.unity-iap-picker__close {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    margin: -6px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--color-close-glyph);
    border-width: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
}

.unity-iap-picker__close:hover {
    color: var(--color-close-glyph-hover);
}

.unity-iap-picker__close-glyph {
    width: 16px;
    height: 16px;
}

/* Buttons are 48pt high, the box's full width, 12pt apart (ButtonHeight, ButtonGap),
 * with 6pt corners (ButtonCornerRadius) and at least 10pt from each edge to the
 * content (ButtonSidePadding). Content centered on one line; the text is
 * 15pt semibold in the spec (ButtonFontSize), bold with the built-in font. Its color
 * is set here per kind and inherited by the label, so it always matches the
 * button's own background rather than the theme. */
.unity-iap-picker__button {
    height: 48px;
    flex-shrink: 0;
    border-radius: 6px;
    border-width: 0;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 10px;
    padding-right: 10px;
    font-size: 15px;
    -unity-font-style: bold;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    transition-duration: 0.12s;
}

.unity-iap-picker__button:active {
    scale: 0.98 0.98;
}

/* After .unity-iap-picker__button so its margin-top wins at equal specificity. */
.unity-iap-picker__button--stacked {
    margin-top: 12px;
}

/* Webshop, and a store without a brand of its own (or with only a logo). */
.unity-iap-picker__button--generic,
.unity-iap-picker__button--webshop {
    background-color: var(--color-generic-bg);
    color: var(--color-button-text);
}

/* The native store: Apple's In-App Purchase lockup, or its name when it has no
 * lockup (the fake store). Black on the light theme, white on the dark one; C#
 * picks the logo variant from the resolved colors, so an override is followed. */
.unity-iap-picker__button--apple-pay,
.unity-iap-picker__button--native {
    background-color: var(--color-native-store-bg);
    color: var(--color-native-store-text);
}

.unity-iap-picker__button--google-pay {
    background-color: var(--color-google-play-bg);
    color: var(--color-google-play-text);
}

.unity-iap-picker__button--coda {
    background-color: var(--color-coda-bg);
    color: var(--color-coda-text);
}

.unity-iap-picker__button--stripe {
    background-color: var(--color-stripe-bg);
    color: var(--color-stripe-text);
}

.unity-iap-picker__button--mock-provider {
    background-color: var(--color-mock-provider-bg);
    color: var(--color-mock-provider-text);
}

/* "Continue with" and the logo, or the whole label: one line, centered by the
 * button. Shrinks (its label ellipsizes) rather than pushing the logo or the badge
 * off the button. */
.unity-iap-picker__button-content {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    min-width: 0;
}

.unity-iap-picker__button-label {
    -unity-text-align: middle-center;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    padding: 0;
    margin: 0;
}

/* Apple's In-App Purchase button: "SF Pro 17pt/20, medium" in the spec. USS has no medium
 * weight, so normal; C# sets the OS system font's Medium face where there is one (Apple
 * platforms), and sets the text on the lockup's baseline. Elsewhere the built-in font, at the
 * same size. */
.unity-iap-picker__button-label--apple {
    font-size: 17px;
    -unity-font-style: normal;
}

/* After "Continue with". Its height, aspect-ratio width and the gap before it
 * depend on the brand, so C# sets them (PaymentOptionPopMetrics.ButtonLogoHeight,
 * ButtonLogoGap). When "Continue with" doesn't fit whole, C# hides it and the logo
 * stands alone (PaymentOptionPopMetrics.FitsLeadText). */
.unity-iap-picker__brand {
    flex-shrink: 0;
}

/* A button with a badge is [content][badge slot]. The slot is the badge and its
 * gaps (PaymentOptionPopMetrics.BadgeReserve) and takes the room left over, so the
 * badge stays at the right end and the content can never run under it (it shrinks
 * instead). C# caps the slot (max-width) when the badge has to give way
 * (PaymentOptionPopMetrics.BadgeRoom), and the badge shrinks and ellipsizes inside
 * it; C# also sets the badge's flex-basis to the width it decided. The content is laid out at the side padding and translated from C# to
 * PaymentOptionPopMetrics.ButtonContentLeft: centered in the button when there is
 * room for the badge's reserve on both sides, otherwise only as far right as the
 * badge allows. Centered, C# also widens __sheet-floor so that the POP grows to keep
 * the content centered, up to its 500pt cap
 * (PaymentOptionPopMetrics.CenteredBadgedButtonMinWidth). */
.unity-iap-picker__badge-slot {
    flex-grow: 1;
    flex-shrink: 0;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

/* Spec "Bonus Reward Chip / Discount Chip": text only, 12pt semibold (bold with the
 * built-in font; the spec's 16pt line fits the 20pt pill), 20pt high, 6pt each side
 * of the text, a pill (BadgeHeight, BadgePadding, BadgeFontSize, BadgeCornerRadius:
 * the spec's radius 100 is fully round, which UI Toolkit draws as half the height).
 * As wide as its text, with no fixed cap: it is ellipsized only when the room its
 * button's content leaves is narrower, and never below 84pt (or its own width, if
 * narrower: PaymentOptionPopMetrics.BadgeMinWidth, UGUI's 72pt of text room plus
 * this padding), so a short badge always shows whole. Above that the label comes
 * first and stays whole; it ellipsizes only if even the 84pt badge has no room
 * beside it. A consumer's min-width and
 * max-width here are honored. margin-left is the gap after the content
 * (ButtonBadgeGap); margin-right plus the button's 10pt puts the badge 20pt from the
 * button's right edge (BadgeRightOffset).
 * No percentage max-width: it makes UI Toolkit measure the text as empty. */
.unity-iap-picker__badge {
    flex-shrink: 1;
    min-width: 0;
    height: 20px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 8px;
    margin-right: 10px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 10px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    background-color: var(--color-badge);
    color: var(--color-badge-text);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Dark variant — toggle via the --dark modifier class on the block. */
.unity-iap-picker--dark {
    --color-sheet: rgb(42, 42, 42);
    --color-sheet-border: rgb(58, 58, 58);
    --color-title: rgb(238, 238, 238);
    --color-generic-bg: rgb(56, 56, 56);
    --color-button-text: rgb(255, 255, 255);
    --color-native-store-bg: rgb(255, 255, 255);
    --color-native-store-text: rgb(0, 0, 0);
    --color-google-play-bg: rgb(255, 255, 255);
    --color-google-play-text: rgb(0, 0, 0);
    --color-close-glyph: rgb(123, 123, 123);
    --color-close-glyph-hover: rgb(220, 220, 230);
    --color-badge: rgb(23, 73, 51);
    --color-badge-text: rgb(177, 241, 203);
}
